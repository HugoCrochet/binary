// ============================================
// Enable Banking API Client
// ============================================
// Client for Enable Banking Open Banking PSD2 API
// Docs: https://docs.enablebanking.com/

import { encrypt, decrypt } from '../../encryption';

// ============================================
// Types
// ============================================
export interface EnableBankingConfig {
  apiKey: string;
  apiSecret: string;
  baseUrl: string;
  redirectUri: string;
}

export interface ConnectionResponse {
  connectionId: string;
  authorizationUrl: string;
  consentId: string;
  expiresAt: string;
}

export interface TokenResponse {
  accessToken: string;
  refreshToken?: string;
  expiresIn: number;
  tokenType: string;
}

export interface AccountsResponse {
  accounts: AccountDetails[];
}

export interface AccountDetails {
  id: string;
  resourceId: string;
  iban?: string;
  bban?: string;
  mask?: string;
  name: string;
  displayName: string;
  product: string;
  type: string;
  currency: string;
  cashBalance: number;
  availableBalance?: number;
  creditLimit?: number;
}

export interface TransactionsResponse {
  transactions: {
    booked: Transaction[];
    pending?: Transaction[];
  };
  account: {
    id: string;
    iban?: string;
  };
}

export interface Transaction {
  id: string;
  transactionId: string;
  bookingDate: string;
  valueDate: string;
  amount: number;
  currency: string;
  creditorName?: string;
  creditorAccount?: {
    iban?: string;
  };
  debtorName?: string;
  debtorAccount?: {
    iban?: string;
  };
  remittanceInformationUnstructured?: string;
  remittanceInformationStructured?: string;
  bankTransactionCode?: string;
  bookingStatus: 'booked' | 'pending';
}

// ============================================
// Client Class
// ============================================
export class EnableBankingClient {
  private config: EnableBankingConfig;
  private accessToken: string | null = null;

  constructor(config: EnableBankingConfig) {
    this.config = config;
  }

  /**
   * Create a new connection and get authorization URL
   */
  async createConnection(
    userId: string,
    institutionId: string,
    accountId?: string
  ): Promise<ConnectionResponse> {
    const response = await this.post('/psd2/connect', {
      userId,
      institutionId,
      accountId,
      redirectUri: this.config.redirectUri,
    });

    return {
      connectionId: response.connectionId,
      authorizationUrl: response.authorizationUrl,
      consentId: response.consentId,
      expiresAt: response.expiresAt,
    };
  }

  /**
   * Exchange authorization code for access token
   */
  async exchangeCodeForToken(code: string): Promise<TokenResponse> {
    const response = await this.post('/psd2/token', {
      grant_type: 'authorization_code',
      code,
      redirectUri: this.config.redirectUri,
    });

    this.accessToken = response.accessToken;
    return response;
  }

  /**
   * Refresh access token using refresh token
   */
  async refreshAccessToken(refreshToken: string): Promise<TokenResponse> {
    const response = await this.post('/psd2/token', {
      grant_type: 'refresh_token',
      refresh_token: refreshToken,
    });

    this.accessToken = response.accessToken;
    return response;
  }

  /**
   * Get accounts for a connection
   */
  async getAccounts(accessToken: string): Promise<AccountsResponse> {
    const response = await this.get('/psd2/accounts', {
      authorization: `Bearer ${accessToken}`,
    });

    return {
      accounts: response.accounts.map((a: any) => ({
        id: a.id,
        resourceId: a.resourceId,
        iban: a.iban,
        bban: a.bban,
        mask: a.mask,
        name: a.name,
        displayName: a.displayName,
        product: a.product,
        type: a.type,
        currency: a.currency,
        cashBalance: a.cashBalance,
        availableBalance: a.availableBalance,
        creditLimit: a.creditLimit,
      })),
    };
  }

  /**
   * Get transactions for an account
   */
  async getTransactions(
    accessToken: string,
    accountId: string,
    startDate?: Date,
    endDate?: Date
  ): Promise<TransactionsResponse> {
    const params = new URLSearchParams({
      accountId,
    });

    if (startDate) {
      params.append('startDate', startDate.toISOString().split('T')[0]);
    }
    if (endDate) {
      params.append('endDate', endDate.toISOString().split('T')[0]);
    }

    const response = await this.get(`/psd2/accounts/${accountId}/transactions?${params}`, {
      authorization: `Bearer ${accessToken}`,
    });

    return {
      transactions: {
        booked: response.transactions.booked.map((t: any) => ({
          id: t.id,
          transactionId: t.transactionId,
          bookingDate: t.bookingDate,
          valueDate: t.valueDate,
          amount: t.amount,
          currency: t.currency,
          creditorName: t.creditorName,
          creditorAccount: t.creditorAccount,
          debtorName: t.debtorName,
          debtorAccount: t.debtorAccount,
          remittanceInformationUnstructured: t.remittanceInformationUnstructured,
          remittanceInformationStructured: t.remittanceInformationStructured,
          bankTransactionCode: t.bankTransactionCode,
          bookingStatus: t.bookingStatus,
        })),
        pending: (response.transactions.pending || []).map((t: any) => ({
          id: t.id,
          transactionId: t.transactionId,
          bookingDate: t.bookingDate,
          valueDate: t.valueDate,
          amount: t.amount,
          currency: t.currency,
          creditorName: t.creditorName,
          creditorAccount: t.creditorAccount,
          debtorName: t.debtorName,
          debtorAccount: t.debtorAccount,
          remittanceInformationUnstructured: t.remittanceInformationUnstructured,
          remittanceInformationStructured: t.remittanceInformationStructured,
          bankTransactionCode: t.bankTransactionCode,
          bookingStatus: t.bookingStatus,
        })),
      },
      account: {
        id: response.account.id,
        iban: response.account.iban,
      },
    };
  }

  /**
   * Get consent status
   */
  async getConsentStatus(consentId: string): Promise<{ status: string }> {
    const response = await this.get(`/psd2/consents/${consentId}`);
    return { status: response.status };
  }

  /**
   * Revoke consent
   */
  async revokeConsent(consentId: string): Promise<void> {
    await this.delete(`/psd2/consents/${consentId}`);
  }

  /**
   * Make GET request to Enable Banking API
   */
  private async get(
    path: string,
    headers: Record<string, string> = {}
  ): Promise<any> {
    const url = `${this.config.baseUrl}${path}`;
    const response = await fetch(url, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        ...headers,
      },
    });

    if (!response.ok) {
      const error = await response.text();
      throw new Error(`Enable Banking API error: ${response.status} - ${error}`);
    }

    return response.json();
  }

  /**
   * Make POST request to Enable Banking API
   */
  private async post(
    path: string,
    body: Record<string, any>
  ): Promise<any> {
    const url = `${this.config.baseUrl}${path}`;
    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-API-Key': this.config.apiKey,
        'X-API-Secret': this.config.apiSecret,
      },
      body: JSON.stringify(body),
    });

    if (!response.ok) {
      const error = await response.text();
      throw new Error(`Enable Banking API error: ${response.status} - ${error}`);
    }

    return response.json();
  }

  /**
   * Make DELETE request to Enable Banking API
   */
  private async delete(path: string): Promise<void> {
    const url = `${this.config.baseUrl}${path}`;
    const response = await fetch(url, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
        'X-API-Key': this.config.apiKey,
        'X-API-Secret': this.config.apiSecret,
      },
    });

    if (!response.ok) {
      const error = await response.text();
      throw new Error(`Enable Banking API error: ${response.status} - ${error}`);
    }
  }
}

// ============================================
// OAuth Flow Helper
// ============================================
/**
 * Generate state parameter for OAuth flow (CSRF protection)
 */
export function generateOAuthState(): string {
  return Math.random().toString(36).substring(2) + Date.now().toString(36);
}

/**
 * Store OAuth state securely (in session or encrypted cookie)
 */
export function storeOAuthState(userId: string, state: string): Promise<void> {
  // In production, store in encrypted session/cookie
  console.log(`Storing OAuth state for user ${userId}: ${state}`);
  return Promise.resolve();
}

/**
 * Validate OAuth state
 */
export function validateOAuthState(userId: string, state: string): boolean {
  // In production, validate against stored state
  console.log(`Validating OAuth state for user ${userId}: ${state}`);
  return true;
}
